# This is the environment file for the Horto-OS setup with IOT LAN.
# Only one of the two .env files should be present on /srv/active_setup.
# Those Variables get copied to active_setup used by setup scripts
# WIFI_INTERFACE: set to none for Ethernet-only IoT-LAN (no hostapd / no USB WiFi).
# Otherwise set the WiFi AP interface name (e.g. wlan0 or wlx…).
WIFI_INTERFACE="none"
WIFI_SSID="Horto-IoT-LAN"
WIFI_PASSPHRASE=""
# Public URL and token used by cloudflared for instance
