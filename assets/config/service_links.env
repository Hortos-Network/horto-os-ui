# Service links shown by the status API (Services panel).
# Copy to /srv/active_setup/service_links.env to override on the box.
#
# HOST empty → box hostname (/etc/hostname). Set HOST=localhost if you only
# reach the box over loopback. LINKS format: Name:port,Name:port,...
# Status-api always merges the full catalog; this file documents defaults and
# may override ports by name.

SCHEME="http"
HOST=""
LINKS="Homepage:3021,Dockge:5001,Cockpit:9890,Open-WebUI:3000,EVCC:7070,Whisper:8000,DeepSeek:8001,Piper:10200,OpenWakeWord:10400,Status-API:8787,MCP:8790"
