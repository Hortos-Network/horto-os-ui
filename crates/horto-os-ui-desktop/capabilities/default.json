{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main Horto window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-list-known-remote-hosts",
    "allow-remote-probe",
    "allow-remote-surfaces-probe",
    "allow-remote-setup",
    "allow-remote-upload-cli",
    "allow-tip-cli-version",
    "allow-api-token",
    "allow-local-host-metrics",
    "allow-list-release-tags"
  ]
}
